{
  "name": "@thdk/nx-pnpm-deploy",
  "version": "0.0.1",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/plugins/plugin.ts",
      "default": "./dist/plugins/plugin.js"
    },
    "./plugin": {
      "development": "./src/plugins/plugin.ts",
      "default": "./dist/plugins/plugin.js"
    }
  },
  "dependencies": {
    "@nx/devkit": "23.3.0-beta.1",
    "nx": "23.3.0-beta.1",
    "tslib": "2.8.1"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "default": "./dist/plugins/plugin.js"
      },
      "./plugin": {
        "default": "./dist/plugins/plugin.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thdk/monorepo",
    "directory": "packages/nx-plugins/nx-pnpm-deploy"
  }
}
