# nx-prune strategy: @nx/js:prune-lockfile emits dist/package.json +
# pnpm-lock.yaml + pnpm-workspace.yaml, @nx/js:copy-workspace-modules copies
# compiled workspace deps into dist/workspace_modules as `file:` directory
# dependencies. pnpm needs to read those directories to install them, so dist
# is copied in one shot rather than split across a manifests-then-source
# layer pair (see nx.dev/docs/kb/deploying-node-projects). The buildkit cache
# mount keeps the pnpm store warm between builds regardless.
ARG NODE_VERSION=lts-alpine
FROM docker.io/node:${NODE_VERSION}

ENV HOST=0.0.0.0
ENV PORT=<%= port %>
ARG SERVICE_VERSION
ENV SERVICE_VERSION=$SERVICE_VERSION

ARG PNPM_VERSION
RUN corepack prepare pnpm@${PNPM_VERSION} --activate
RUN corepack enable pnpm

WORKDIR /app

COPY ./dist .

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --prod --frozen-lockfile --ignore-scripts

CMD [ "node", "main.js" ]
