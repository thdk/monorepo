{
  "name": "@thdk/eslint-plugin",
  "version": "0.0.4",
  "private": false,
  "description": "ESLint rules for monorepo and app structure: require import aliases across module boundaries, keep relative imports inside them.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "flat-config",
    "import",
    "alias",
    "path-alias",
    "monorepo"
  ],
  "author": "Thomas Dekiere",
  "license": "MIT",
  "homepage": "https://github.com/thdk/monorepo/tree/main/packages/eslint-plugin#readme",
  "bugs": {
    "url": "https://github.com/thdk/monorepo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "tslib": "2.8.1"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "peerDependencies": {
    "eslint": "9.8.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thdk/monorepo.git",
    "directory": "packages/eslint-plugin"
  }
}
